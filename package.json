{
  "name": "campfire",
  "version": "0.1.0",
  "private": true,
  "description": "Make friends as PS1-style avatars. 100% local AI (QVAC) + peer-to-peer (Pears). No servers.",
  "main": "expo-router/entry",
  "scripts": {
    "build:creator": "node scripts/build-creator.mjs",
    "prestart": "npm run build",
    "start": "expo start --dev-client",
    "android": "npm run build && expo run:android",
    "ios": "npm run build && expo run:ios",
    "prebuild": "npm run build && expo prebuild",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview:creator": "npm run build:creator && echo 'open web/dist/creator.html (add #hub for the campfire scene)'",
    "build:worker": "node scripts/build-worker.mjs",
    "build": "npm run build:creator && npm run build:worker"
  },
  "dependencies": {
    "@qvac/asr-ggml-android-arm64": "0.11.2",
    "@qvac/asr-ggml-ios": "0.11.2",
    "@qvac/fabric-android-arm64": "0.25.0",
    "@qvac/fabric-ios": "0.25.0",
    "@qvac/sdk": "^0.23.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "autobase": "^7.28.2",
    "b4a": "^1.9.0",
    "corestore": "^7.16.1",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.0",
    "hyperbee": "^2.27.3",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.2",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-bare-kit": "0.16.0",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "react-native-svg": "^15.16.1",
    "react-native-webview": "^14.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "bare-pack": "^3.0.2",
    "hyperdht": "^6.0.0",
    "three": "0.160.0",
    "typescript": "~5.9.0"
  }
}
